# Noctalia runtime state — regenerated automatically on theme/color changes
noctalia/.config/noctalia/colors.json

# Machine-specific niri config — generated by 3-install-dots.sh from machine.kdl.<profile>
niri/.config/niri/machine.kdl
niri/.config/niri/output.kdl

# Machine identity — set locally, never synced
.config/dotfiles/machine.env
