[layout]
extent_presets = [0.333, 0.5, 0.667] # shared by scrolling, dwindle, and master

[layout.master]
default_width_fraction = 0.55  # 0.1-0.9

[layout.scrolling]
# Vertical workspaces stack horizontal lanes from top to bottom.
# direction = "horizontal"
default_width_fraction = 0.33  # remove to let clients choose their initial width

[[window_rule]]
match.app_id = "^com.mitchellh.ghostty"
default_scrolling_extent = 0.333