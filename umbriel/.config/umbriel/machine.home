# Home profile: copy to machine.toml to activate.
# Niri machine.kdl.home: default 0.5, Ghostty 0.3333.
[layout]
extent_presets = [0.3333, 0.5, 0.6]

[layout.scrolling]
default_extent_fraction = 0.5

[layout.master]
default_width_fraction = 0.55

[[window_rule]]
match.app_id = '^com\.mitchellh\.ghostty$'
default_scrolling_extent = 0.3333
