[layout]
extent_presets = [0.333, 0.5, 0.667] # shared by scrolling, dwindle, and master

[layout.scrolling]
# Vertical workspaces stack horizontal lanes from top to bottom.
# direction = "horizontal"
default_width_fraction = 0.25  # remove to let clients choose their initial width

[layout.master]
default_width_fraction = 0.55  # 0.1-0.9

[[window_rule]]
match.app_id = "^com.mitchellh.ghostty"
default_scrolling_extent = 0.25

# Zoom's XWayland hover surfaces can arrive as top-level windows. Keep them out of the tile layout.
[[window_rule]]
match.app_id = "(?i)^zoom$"
default_floating = true