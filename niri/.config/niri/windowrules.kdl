// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Window-Rules

// Open Ghostty at 33%
window-rule {
    match title="Ghostty" 
    //Home
    default-column-width { proportion 0.3333; }
    //Work
    // default-column-width { proportion 0.2; }
    //Laptop
    // default-column-width { proportion 0.5; }
    
}
// Open Wezterm at 33%
window-rule {
    match app-id=r#"wezterm"# 
    default-column-width { proportion 0.333; }
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}


// (This example rule is commented out with a "/-" in front.)
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}


window-rule {
    // Only this specific terminal floats
    match app-id="com.mitchellh.ghostty" title="floating-terminal"
    open-floating true
}

window-rule {
    // Only this specific terminal floats
    match app-id=r#"pavucontrol$"#
    open-floating true
}

window-rule {
    // Only this specific terminal floats
    match app-id=r#"org.gnome.Calculator$"#
    open-floating true
}

// Machine-specific window rules are in machine.kdl (not tracked in git).
// See machine.kdl.home / machine.kdl.work / machine.kdl.laptop for templates.
