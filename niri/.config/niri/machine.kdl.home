// machine.kdl.home — copy to machine.kdl on home desktop
// Installed by 3-install-dots.sh when profile=home

layout {
    preset-column-widths {
        proportion 0.3333
        proportion 0.5
        proportion 0.6
    }
    default-column-width { proportion 0.5; }
}

// Home has a single ultrawide on DP-1
output "DP-1" {
    scale 1
    transform "normal"
    position x=0 y=0
}

window-rule {
    match title="Ghostty" 
    //Home
    default-column-width { proportion 0.3333; }
}