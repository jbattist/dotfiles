// machine.kdl.laptop — copy to machine.kdl on laptop
// Installed by 3-install-dots.sh when profile=laptop

layout {
    preset-column-widths {
        proportion 0.3333
        proportion 0.5
        proportion 0.6666
        proportion 0.8
    }
    default-column-width { proportion 0.6666; }
}

// Output name is filled in by 3-install-dots.sh from `niri msg outputs`.
// If auto-detection fails, edit this to your real output name (run `niri msg outputs`).
output "__NIRI_OUTPUT__" {
    scale 1.2
    transform "normal"
    position x=0 y=0
}

window-rule {
    match title="Ghostty" 
    //Laptop
    default-column-width { proportion 0.5; }
    
}
